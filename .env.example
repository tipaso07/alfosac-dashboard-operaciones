POSTGRES_DB=alfosac_dashboard
POSTGRES_USER=dashboard_user
POSTGRES_PASSWORD=cambia_esta_clave
POSTGRES_PORT=5434

API_PORT=5100
TV_PORT=8090

# Se activarán únicamente cuando se haya validado el acceso de solo lectura.
FALCON_SYNC_ENABLED=false
FALCON_SYNC_INTERVAL_SECONDS=60
FALCON_IMPORT_ENABLED=false
FALCON_AUTO_SYNC_ENABLED=false
FALCON_DB_HOST=
FALCON_DB_PORT=1433
FALCON_EXTRANET_DB=
FALCON_MAESTROS_DB=
FALCON_DB_USER=
FALCON_DB_PASSWORD=
FALCON_DB_ENCRYPT=false
FALCON_DB_TRUST_CERTIFICATE=true
GITS_SYNC_ENABLED=false
# Al habilitarlo, Falcon se enriquece solo con coincidencias físicas seguras de GITS.
GITS_ENRICH_FALCON_ENABLED=false
GITS_DB_HOST=
# Para una instancia SQL Server nombrada, por ejemplo SQLFWDR02. Si se usa,
# deja GITS_DB_PORT vacío para resolver la instancia.
GITS_DB_INSTANCE=
GITS_DB_PORT=
GITS_DB_NAME=
GITS_DB_USER=
GITS_DB_PASSWORD=
# Código de empresa de GITS usado para enlazar volantes. Confirmado inicialmente: 00001.
GITS_EMPRESA_CODE=00001
GITS_DB_ENCRYPT=false
GITS_DB_TRUST_CERTIFICATE=true

# Opcional: fecha específica a revisar (YYYY-MM-DD). Si queda vacía muestra el día actual de Lima.
DASHBOARD_REPORT_DATE=

